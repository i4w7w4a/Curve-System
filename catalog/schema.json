{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/i4w7w4a/Curve-System/blob/main/catalog/schema.json",
  "title": "Curve System catalog 0.1.0",
  "description": "Generated registry metadata. Runtime validates parameter values; this schema validates the registry structure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedBy", "sourceReviewDate", "curves"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "generatedBy": { "const": "scripts/render-atlas.mjs" },
    "sourceReviewDate": { "type": "string", "format": "date" },
    "curves": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/curve" }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "min", "max", "step", "default", "integer"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "label": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "default": { "type": "number" },
        "integer": { "type": "boolean" }
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "nameRu", "family", "variant", "formula", "description", "parameters", "properties", "notes", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string" },
        "nameRu": { "type": "string" },
        "family": { "type": "string" },
        "variant": { "type": "string" },
        "formula": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "derivativeVariable", "derivativeMethod", "status", "monotone", "bounded", "normalizedEndpoints", "continuous"],
          "properties": {
            "domain": { "const": [0, 1] },
            "derivativeVariable": { "const": "normalized-time" },
            "derivativeMethod": { "const": "analytic-forward-ad-order-3" },
            "status": { "const": "implemented" },
            "monotone": { "enum": [true, false, "parameter-dependent"] },
            "bounded": { "enum": [true, false, "parameter-dependent"] },
            "normalizedEndpoints": { "type": "boolean" },
            "continuous": { "type": "boolean" },
            "clampedContinuity": { "enum": ["C1", "C2", "C3"] },
            "endpointPolicy": { "enum": ["asymptotic", "normalize-value", "initial-jump", "final-jump"] }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
      }
    }
  }
}
